# Copy to .env and adjust. Never commit the real .env file.
DATABASE_URL=postgresql+psycopg2://leaveflow:leaveflow@localhost:5432/leaveflow
TEST_DATABASE_URL=postgresql+psycopg2://leaveflow:leaveflow@localhost:5432/leaveflow_test

# Application behaviour
APP_TIMEZONE=Asia/Kolkata
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_DOCUMENT_MB=5
SICK_LEAVE_CODE=SICK
NON_ABSENCE_CODES=WFH
SQL_ECHO=false
